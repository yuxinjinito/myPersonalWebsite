---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = "About Me";
const identity = {
    firstName: "Yuxin",
    HomeCity: "Shanghai,China",
    hobbies: ["coding", "travelling", "watching movies", "reading"],
    birthDate: "09-30-2005",
};

const skills = ["Python","Java","JavaScript","HTML"];
const happy = true;

const skillColor = "crimson";
const fontWeight = "bold";
const textCase = "uppercase"
---

<BaseLayout pageTitle={pageTitle}>
    <h4>Personal Statement</h4>
    <p>I am a student at the University of Wisconsin-Madison, pursuing a Bachelor in Computer Science.</p>
    <p>Facts about me:</p>
    <ul>
        <li>I was born on {identity.birthDate}.</li>
        <li>I come from {identity.HomeCity}.</li>
        <li>My hobbies are {identity.hobbies.join(", ")}.</li>
        <li>My skills are 
            <ul>
                {skills.map((skill) => <li class="skill">{skill}</li>)}
            </ul></li>
        <li>{happy && <p>Dark Secret: I broked my arm when I was planning a solo trip around South America 2 months ago.</p>}</li>
    </ul>

    <style is:global define:vars={{skillColor, fontWeight, textCase}}>
        h1 {
          color: purple;
          font-size: 4rem;
        }
        .skill {
            color: var(--skillColor);
            font-weight: var(--fontWeight);
            text-transform: var(--textCase);
        }
    </style>
</BaseLayout>
